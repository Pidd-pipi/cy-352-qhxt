# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=lpboardgame

# 数据库账号与库名
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# JWT 签名密钥，生产环境请替换为随机长字符串
JWT_SECRET=change_me_to_a_long_random_string

# 宿主机映射端口（容器内端口固定：前端 80 / 后端 29512 / 数据库 27017）
FRONTEND_PORT=28512
BACKEND_PORT=29512
DB_PORT=27017
